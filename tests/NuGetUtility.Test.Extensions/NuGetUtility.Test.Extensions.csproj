<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net472</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- This project holds test helpers rather than tests, so TUnit's generated test host
         infrastructure is dead weight, and its module initializer does not compile on net472. -->
    <EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoFixture" />
    <PackageReference Include="AutoFixture.AutoNSubstitute" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="TUnit.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NuGetUtility\NuGetUtility.csproj" />
  </ItemGroup>
</Project>
