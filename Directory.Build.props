<Project>

  <!-- Verify's sponsorship nag is exempt for open source projects; the exemption has to be
       renewed before the date below. https://github.com/VerifyTests/Verify#sponsorship -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('.Test'))">
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

</Project>
