{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "ignoreDeps": [
    "dotnet-sdk"
  ],
  "packageRules": [
    {
      "description": "Fixture projects are inputs for the tests, which assert their exact dependency graphs.",
      "matchFileNames": [
        "tests/targets/**",
        "integration/**"
      ],
      "enabled": false
    }
  ],
  "minimumReleaseAge": "48 hours"
}
